# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 项目特定
# data 锚定根目录：只忽略仓库根数据目录，保留 backend/data/ 代码包
/data/
# logs 全部忽略（均为运行时日志：根 logs/ 与 backend/logs/ 都不提交）
logs/
# backend 运行时数据子目录（本地 import app 副产物；backend/data/ 仅保留 .py 代码，
# 忽略运行时生成的 jarvis/health/daily/realtime 等，生产由 docker 数据卷管理）
# 注意：data_processor 是代码包（目录），须纳入版本控制；
# 用 `*/*`（忽略子目录内文件）而非 `*/`（会忽略整个 data_processor 目录且无法 re-include），
# 再把包内 .py 显式放行。
backend/data/*/*
!backend/data/data_processor/*.py
config/ai_config.json
config/feishu_config.json
config/wechat_config.json
config/stock_monitor.json
config/jarvis_token.json
config/redemption_codes.json
config/otp_config.json
config/session_secret.json
# 运行时状态/缓存文件(后端运行中重写,每天变化):不入版本库——否则生产环境
# git pull 必然与服务器本地改动冲突(2026-11-06 部署拉取失败根因)。
# 读取方均有缺文件防护,运行后自动再生;拉取脚本另带丢弃本地改动防护
config/ai_news_summary_status.json
config/ai_news_summary_result.md
config/ai_daily_status.json
config/ai_daily_result.md
config/industry_cycle_status.json
config/industry_cycle_result.json
config/name_code_cache.json
# 虚拟支付订单/权益库(含用户openid与交易数据,不入版本库)
backend/data/mp_vpay.db
# 微信送检探针词条(手动填敏感词,绝不入库)
backend/scripts/sec_probe_words.txt
# 个人数字分身 Agent: 数据目录(聊天记录+知识库,由人工/本地同步器维护)与含密钥配置不入库
backend/agent_data/
backend/agent_core/config.json
backend/agent_core/cache/
backend/agent_core/web/

