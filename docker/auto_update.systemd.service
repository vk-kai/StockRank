# StockRank 自动更新 systemd 服务单元
#
# 部署:
#   sudo cp docker/auto_update.systemd.service /etc/systemd/system/auto_update.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now auto_update        # 开机自启 + 立即启动
#   journalctl -u auto_update -f                    # 实时日志
#   sudo systemctl status auto_update               # 查看状态
#
# 如安装路径不是 /root/StockRank,请同步修改下面的 WorkingDirectory / ExecStart。
# 可用 systemctl edit auto_update 覆盖环境变量(如 CHECK_INTERVAL、AVOID_TRADING_HOURS)。

[Unit]
Description=StockRank Git 自动更新与容器重建
Documentation=https://github.com/vk/StockRank
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=/root/StockRank
Environment=CHECK_INTERVAL=300
Environment=GIT_BRANCH=main
Environment=AVOID_TRADING_HOURS=1
ExecStart=/root/StockRank/docker/auto_update.sh
Restart=always
RestartSec=10
# 脚本自身已写 logs/auto_update.log;这里再把 stdout/stderr 收一份到 journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
