ALIPAY_RETURN_URL=https://0vk.top/quant/
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
PAYMENT_MOCK_ENABLED=false

# 统一门禁(gateway 模式,生产 compose 已注入;本地 standalone 开发无需设置)
# QUANT_GATE_MODE=1
# QUANT_GATE_SECRET=vK-TzGate-9f2c7a1e

# 树莓派边缘节点卸载（默认关闭；关闭时回测完全走本机，零行为变化）
PI_NODE_ENABLED=false
PI_NODE_URL=http://host.docker.internal:8765
PI_NODE_TOKEN=
PI_NODE_OFFLOAD_MODE=both
PI_NODE_SINGLE_TIMEOUT=120
PI_NODE_BATCH_TIMEOUT=300
PI_NODE_BATCH_CHUNK=50
PI_NODE_HEALTH_INTERVAL=15
PI_NODE_COOLDOWN=60
PI_NODE_PROBE_TIMEOUT=2.0
PI_NODE_MAX_DF_KB=512

# 套利背离监控(分时叠加 + 盘中滞涨/抗跌提示 + 盘前KOSPI提示)
ARB_MONITOR_ENABLED=true
ARB_MONITOR_INTERVAL_SECONDS=15
ARB_CORR_WINDOW=15
ARB_CORR_MIN=0.5
ARB_BETA_WINDOW=90
ARB_BETA_MIN=0.2
ARB_BETA_MAX=5.0
ARB_SIGMA_WINDOW=60
ARB_SPREAD_K=2.0
ARB_DRIFT_MINUTES=5
ARB_DRIFT_TAIL_Q=0.95
ARB_DRIFT_TAIL_MIN_SAMPLES=30
ARB_BENCH_MOM_WINDOW=15
ARB_BENCH_MOM_Z=1.0
ARB_ALERT_COOLDOWN_MINUTES=20
ARB_MIN_OVERLAP_SAMPLES=25
ARB_PREOPEN_KOSPI_PCT=0.8
ARB_PREOPEN_STOCK_FLAT_PCT=0.3
ARB_TRENDS_CACHE_TTL=12
ARB_TRENDS_STALE_MAX_SECONDS=300
ARB_MAX_PAIRS=20
