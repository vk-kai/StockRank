# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/

# Node.js dependencies
node_modules/

# Vite build output and cache
dist/
!frontend/dist/
!frontend/dist/**
.vite/
*.local
.env
.env.*
!.env.example
!docker/.env

# Data files
# 忽略 data 目录下的所有文件
data/*

# 但不忽略 .json 文件
!data/*.json
data/pytdx_hosts.json

# Logs
# 忽略 logs 目录下的所有文件，但保留策略更新日志
logs/*
!logs/策略更新日志.md
